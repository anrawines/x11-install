#!/bin/bash
# bspwm - Configuration script
# This script runs on X startup and configures bspwm

# Number of desktops per monitor
bspc monitor -d 1 2 3 4 5

# ============================================
# bspwm Configuration
# ============================================

# Border and gaps
bspc config border_width        2
bspc config window_gap          10
bspc config split_ratio         0.52

# Behavior
bspc config borderless_monocle  true
bspc config gapless_monocle     true
bspc config focus_follows_pointer true
bspc config automatic_scheme    spiral
bspc config removal_adjustment  true

# Colors
bspc config normal_border_color     "#2e3440"
bspc config focused_border_color    "#81a1c1"
bspc config presel_feedback_color   "#5e81ac"

# ============================================
# Autostart Applications
# ============================================

# Kill previously running instances
pkill -f "dunst|picom|sxhkd"

# Start sxhkd for hotkeys
sxhkd &

# Start notification daemon
dunst &

# Start compositor
picom &

# Start polybar (if installed)
if command -v polybar >/dev/null 2>&1; then
    polybar main &
fi

# ============================================
# Window Rules (bspc rule)
# ============================================

# Make certain windows floating
bspc rule -a "feh" state=floating
bspc rule -a "Galculator" state=floating
bspc rule -a "Lxappearance" state=floating
bspc rule -a "Pavucontrol" state=floating

# Desktop assignments (optional)
bspc rule -a "Firefox" desktop=^1
bspc rule -a "Thunar" desktop=^3
bspc rule -a "Discord" desktop=^5
