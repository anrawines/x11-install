/* SPLIT TAB */
#tabbrowser-tabpanels {
  &[splitview] {
    & .browserContainer {
      outline: 2px solid #303f46 !important;

      .deck-selected > & {
        outline: 2px solid #5a7582 !important;
      }

      &:first-child {
        outline: none !important;
        border: 2px solid #303f46 !important;

        .deck-selected > & {
          outline: none !important;
          border: 2px solid #5a7582 !important;
        }
      }
    }
  }
}

.tabbrowser-tab[pinned] {
    margin-inline: 0px !important;
}

/* Change the background and text color of pinned tabs */
.tabbrowser-tab[pinned] .tab-stack {
    background-color: #000000 !important;
    border-radius: 0px !important;
    min-height: 34px !important;
    max-height: 34px !important;
    padding-top: 0px !important;
    padding-bottom: 0px !important;
	margin: 0 !important;
	width: 100% !important;
}

/* Optional: Change the label color to ensure readability */
.tabbrowser-tab[pinned] .tab-label {
    color: white !important;
}

/* If you prefer a border/outline effect instead of a solid background */
.tabbrowser-tab[pinned] .tab-content {
    
    box-shadow:
    inset 1px 0 0 0 #6686FF,   /* Left */
    inset -1px 0 0 0 #6686FF,  /* Right */
	inset 0 4px 0 0 #6686FF,   /* Top (Adjust 3px to taste) */
    inset 0 -4px 0 0 #6686FF !important; /* Bottom (Adjust 3px to taste) */
    
    padding: 3 !important;          /* Ensure no internal spacing pushes the outline */
    margin: 3 !important;           /* Ensure the content fills the stack */
}
