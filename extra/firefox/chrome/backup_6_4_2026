
/* ------------------------------------------------------------------------MEDIA QUERIES FOR ONELINE NAVBAR----------------------------------------------------------- */

@media (min-width: 950px) {
	#nav-bar {
    order: 1 !important;
    flex: 0 0 20% !important; /* your NavbarWidth logic */
    padding-block: 0 !important;
    align-items: center !important;
    min-height: 28px !important;
    max-height: 28px !important;
    margin-top: 4px !important; /* adjust 2–6px to taste */
    
  }
  
    #TabsToolbar {
	order: 2 !important;
	min-height: 30px !important;
    max-height: 30px !important;
    padding: 4px !important;    /* Changed from 4px to 0px */
    
    flex: 1 1 auto !important;
    align-items: center !important;
    margin-top: 4px !important;  /* Ensure this is 0px */
  }

	#PersonalToolbar {
	order: 3 !important;
	width: 100% !important;
	padding: 0 4px !important; /* horizontal only */
		
  }

	#navigator-toolbox {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: wrap !important;
    align-items: flex-start !important;
    margin-top: 0px !important;   
  }

  #urlbar-container {
    flex: 1 !important;
  }

 

}


