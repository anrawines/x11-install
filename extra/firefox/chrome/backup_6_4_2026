/* ===== FLOATING SIDEBAR - SIMPLIFIED ===== */
#sidebar-box {
  position: fixed !important;
  top: 95px !important;
  right: 0px !important;
  left: auto !important;
  width: 350px !important;
  height: calc(100vh - 90px) !important;
  background: var(--toolbar-bgcolor) !important;
  border-left: 1px solid var(--sidebar-border-color) !important;
  z-index: 10000 !important;
}

#sidebar-box[sidebarvisible="true"] {
  display: block !important;
  transform: none !important;
}

#sidebar {
  height: 100% !important;
  width: 100% !important;
}

#sidebar-header {
  background: var(--toolbar-bgcolor) !important;
  border-bottom: 1px solid var(--sidebar-border-color) !important;
  padding: 4px !important;
}

/* Remove any potential splitter */
#sidebar-splitter {
  display: none !important;
}

/* Ensure web content doesn't get pushed */
#browser {
  position: relative !important;
}


